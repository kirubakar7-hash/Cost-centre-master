# =====================================================================
# SolidPro Cost Centre Portal - environment variables
#
# Local demo:  cp .env.example .env.local, set AUTH_SECRET and
#              AUTH_DEMO_MODE=true, then run `npm run dev`.
# Vercel:      Project -> Settings -> Environment Variables (see README).
#
# Lines that start with "#" are optional. Leave a variable commented out
# rather than setting it to an empty value.
# NOTE: the `npm run db:*` scripts do NOT read this file. Export the
# variables in your shell, or run
#   npx tsx --env-file=.env.local scripts/db.ts migrate
# =====================================================================

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# Postgres connection string (Supabase: Project -> Connect -> "Transaction
# pooler", port 6543). If it is unset, an embedded PGlite database is created
# in ./.pglite, migrated and seeded with demo data automatically.
# Do not add ?sslmode=... here. Use DATABASE_SSL / DATABASE_SSL_STRICT below,
# because an sslmode parameter overrides those settings.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Maximum connections per server instance (default 5). Keep this low on serverless.
# DATABASE_POOL_MAX=5

# TLS to Postgres is on by default. Set to 'false' only for a local Postgres
# without TLS (sslmode=disable in DATABASE_URL has the same effect).
# DATABASE_SSL=false

# Verify the server certificate (default true). Set to 'false' if the
# connection fails with "self-signed certificate in certificate chain" and you
# cannot install the provider's CA certificate (see README -> Supabase).
# Traffic stays encrypted, but the server's identity is not verified.
# DATABASE_SSL_STRICT=false

# Embedded PGlite data directory (default ./.pglite). 'memory' = in-memory,
# so the data is lost on restart. Used only when DATABASE_URL is unset.
# PGLITE_DATA_DIR=./.pglite

# Allow the embedded PGlite database when NODE_ENV=production
# (for `npm run build && npm start` demos only, never for a real deployment).
# ALLOW_EMBEDDED_DB=true

# ---------------------------------------------------------------------
# Auth.js (sign-in and session)
# ---------------------------------------------------------------------
# REQUIRED. Random secret that encrypts the session cookie.
# Generate one with:  npx auth secret   or   openssl rand -base64 32
AUTH_SECRET=

# Public base URL of the site. Optional locally. On Vercel, set it for the
# Production environment only, because previews would otherwise send
# sign-in callbacks to production.
# AUTH_URL=https://costcentre.solidpro-engineering.com
# AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Microsoft Entra ID single sign-on (README -> "Microsoft Entra ID SSO")
# All three are required for real sign-in. Without ID and SECRET, the
# "Sign in with Microsoft" button is disabled.
# ---------------------------------------------------------------------
# App registration -> Overview -> Application (client) ID
# AUTH_MICROSOFT_ENTRA_ID_ID=00000000-0000-0000-0000-000000000000
# App registration -> Certificates & secrets -> client secret VALUE (not the Secret ID)
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# App registration -> Overview -> Directory (tenant) ID.
# ALWAYS set this. It pins sign-in to the SolidPro tenant and turns on the
# token `tid` check. Required: without it Microsoft sign-in is disabled.
# AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------
# Access policy
# ---------------------------------------------------------------------
# Comma-separated e-mail domains that may sign in. They are also the only
# domains accepted for owners and backups in the owner mapping upload.
# Default: solidpro-es.com
ALLOWED_EMAIL_DOMAINS=solidpro-es.com

# Shown to employees when a search finds nothing ("Contact Finance at ...").
# Default: finance@solidpro-es.com
FINANCE_CONTACT_EMAIL=finance@solidpro-es.com

# 'true' shows a "sign in as demo user" picker on the login page (no password).
# Only works with the embedded PGlite demo DB: ignored whenever DATABASE_URL is
# set, and always off when VERCEL_ENV=production.
AUTH_DEMO_MODE=false

# ---------------------------------------------------------------------
# Budget & Actuals (Phase 2). Leave these commented out in Production
# unless Finance has approved a different value.
# ---------------------------------------------------------------------
# Maker-checker on every upload (default ON). The uploader cannot publish
# their own upload, and only the uploader can enter the trial balance.
# Only the exact value 'false' turns it off: use that for a single-user demo
# or test, never for a real deployment.
# UPLOAD_MAKER_CHECKER=false

# Largest allowed difference between a period's cost centre actuals and the
# trial-balance total entered by Finance, in the file's amount units.
# Default 0 (must be equal to the paisa). Negative or non-numeric values
# are treated as 0.
# RECON_TOLERANCE=0

# First month of the fiscal year, 1-12 (default 4 = April, so FY 2026-27 is
# Apr 2026 - Mar 2027). Drives YTD, full-year budget and outturn in
# My Cost Centres and the Excel export. Read at start-up; not validated.
# FY_START_MONTH=4

# ---------------------------------------------------------------------
# Build (optional)
# ---------------------------------------------------------------------
# Alternate Next.js build folder (default .next), so that two builds can run
# side by side on one machine. Do not set it on Vercel.
# NEXT_DIST_DIR=.next-alt

# ---------------------------------------------------------------------
# Scripts only
# ---------------------------------------------------------------------
# `npm run db:reset` refuses to drop a remote database (DATABASE_URL set)
# unless this is 'yes'. Never set it permanently.
# CONFIRM_RESET=yes

# Set automatically by Vercel. Do not set it yourself.
# VERCEL_ENV=production
